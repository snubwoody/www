---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/blog.css";
import { getCollection, getEntry, render } from "astro:content";
import { formatDate } from "../../../lib/format";

const { article } = Astro.params;
export const getStaticPaths = async () => {
    const articles = await getCollection("articles", (post) => {
        return post.data.preview !== true;
    });

    return articles.map((a) => {
        return {
            params: { article: a.id },
        };
    });
};

if (!article) {
    return Astro.redirect("/blog");
}

const post = await getEntry("articles", article);

if (!post) {
    return Astro.redirect("/404");
}

const { Content, remarkPluginFrontmatter: frontmatter, headings } = await render(post);

const image = post.data.image;
---

<BaseLayout title={`${post.data.title} - Wakunguma Kalimukwa`}>
    <Fragment slot="head">
        <meta
            name="og:url"
            content={`https://www.wakunguma.com/blog/${post.id}`}
        />
        <meta
            property="og:image"
            content={`https://www.wakunguma.com${image}`}
        />
        <meta property="og:locale" content="en_GB" />
        <meta
            property="og:image:url"
            content={`https://www.wakunguma.com${image}`}
        />
        <meta property="article:author" content="Wakunguma Kalimukwa" />
        <meta name="twitter:card" content={"summary_large_image"} />
        <meta
            name="twitter:image"
            content={`https://www.wakunguma.com${image}`}
        />
    </Fragment>
    <main class="content">
        <header>
            <h1 class="max-md:text-h3 mb-8 text-h1 font-medium">
                {post.data.title}
            </h1>
            <ul class="metadata">
                <li>
                    <p>{formatDate(post.data.published.toString())}</p>
                </li>
                <li>—</li>
                <li>
                    <p>{frontmatter.minutesToRead} minute read</p>
                </li>
            </ul>
        </header>
        <div class="flex gap-56 pb-64 justify-center relative">
            <article class="blog-content">
                <Content />
            </article>
            <!--TODO: hide if there are no headings (and test)-->
            <div class="w-full max-w-[20ch] space-y-8 toc max-md:hidden">
                <h6 class="font-medium">Contents</h6>
                <ul class="space-y-8">
                    {headings.map((heading) =>
                        <li style={{"--depth": `${heading.depth - 2}`}}>
                            <a href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                    )}
                </ul>
            </div>
        </div>
    </main>
</BaseLayout>

<style>
    .toc {
        li{
            margin-left: calc(16px * var(--depth));
        }
    }

    .toc a{
        width: fit-content;
        max-width: 100%;
        position: relative;
        color: var(--color-accent);

        &::after {
            position: absolute;
            bottom: -2px;
            left: 0;
            content: "";
            width: 100%;
            height: 2px;
            opacity: 0;
            transform: scaleX(0);
            background: var(--color-accent);
            transition: all 250ms cubic-bezier(.79,.14,.15,.86);
        }

        &:hover {
            &::after {
                transform: scaleX(1);
                opacity: 1;
            }
        }
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 36px;
        width: 100%;
        scroll-behavior: smooth;
        margin: 0 auto;
    }

    .metadata {
        display: flex;
        align-items: center;
        gap: 4px;

        li {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--color-text-muted);
        }

        .metadata-divider {
            width: 2px;
            height: 24px;
            background-color: var(--color-neutral-50);

            @media (width < 768px) {
                display: none;
            }
        }
    }

    header {
        display: flex;
        flex-direction: column;
        padding-top: 32px;
    }

    .thumbnail {
        width: 100%;
        object-fit: cover;
        aspect-ratio: 21/9;

        @media (width < 768px) {
            aspect-ratio: 16/9;
        }
    }
</style>

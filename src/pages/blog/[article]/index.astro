---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/blog.css";
import { getCollection, getEntry, render } from "astro:content";
import { formatDate } from "../../../lib/format";

const { article } = Astro.params;
export const getStaticPaths = async () => {
    const articles = await getCollection("articles", (post) => {
        return post.data.preview !== true;
    });

    return articles.map((a) => {
        return {
            params: { article: a.id },
        };
    });
};

if (!article) {
    return Astro.redirect("/blog");
}

const post = await getEntry("articles", article);

if (!post) {
    return Astro.redirect("/404");
}

const { Content, remarkPluginFrontmatter: frontmatter } = await render(post);

const image = post.data.image;
---

<BaseLayout title={`${post.data.title} - Wakunguma Kalimukwa`}>
    <Fragment slot="head">
        <meta
            name="og:url"
            content={`https://www.wakunguma.com/blog/${post.id}`}
        />
        <meta
            property="og:image"
            content={`https://www.wakunguma.com${image}`}
        />
        <meta property="og:locale" content="en_GB" />
        <meta
            property="og:image:url"
            content={`https://www.wakunguma.com${image}`}
        />
        <meta property="article:author" content="Wakunguma Kalimukwa" />
        <meta name="twitter:card" content={"summary_large_image"} />
        <meta
            name="twitter:image"
            content={`https://www.wakunguma.com${image}`}
        />
    </Fragment>
    <main class="content">
        <header>
            <h1 class="max-md:text-h3 mb-8 text-h1 font-medium">
                {post.data.title}
            </h1>
            <ul class="metadata">
                <li>
                    <p>{formatDate(post.data.published.toString())}</p>
                </li>
                <li>—</li>
                <li>
                    <p>{frontmatter.minutesToRead} minute read</p>
                </li>
            </ul>
        </header>
        <div class="flex gap-64 pb-64 justify-center">
            <div class="space-y-40">
                <article class="blog-content">
                    <Content />
                </article>
            </div>
        </div>
    </main>
</BaseLayout>

<style>
    .content {
        display: flex;
        flex-direction: column;
        gap: 36px;
        width: 100%;
        scroll-behavior: smooth;
        margin: 0 auto;
    }

    .metadata {
        display: flex;
        align-items: center;
        gap: 4px;

        li {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--color-text-muted);
        }

        .metadata-divider {
            width: 2px;
            height: 24px;
            background-color: var(--color-neutral-50);

            @media (width < 768px) {
                display: none;
            }
        }
    }

    header {
        display: flex;
        flex-direction: column;
        padding-top: 32px;
    }

    .thumbnail {
        width: 100%;
        object-fit: cover;
        aspect-ratio: 21/9;

        @media (width < 768px) {
            aspect-ratio: 16/9;
        }
    }

    .heading-link {
        padding: 8px 16px;
        margin-left: calc(16px * var(--depth));
        border-left: 2px solid color-mix(in oklch, black 5%, transparent);
        position: relative;
        [data-theme="dark"] & {
            border-color: color-mix(in oklch, white 5%, transparent);
        }
    }
</style>

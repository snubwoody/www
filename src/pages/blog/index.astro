---
import Layout from "../../layouts/BaseLayout.astro";
import { getPosts, sortPosts } from "../../lib";
import { formatDate } from "../../lib/format";

const articles = await getPosts({ sort: true });
const posts = sortPosts(articles, "date_created");
---

<Layout title="Browse articles">
    <main class="py-44 space-y-36">
        <header>
            <h3>Articles</h3>
        </header>
        <ul class="space-y-24">
            {
                posts.map((post) => (
                    <li>
                        <a
                            href={`/blog/${post.id}`}
                            class="blog-post"
                            data-astro-prefetch
                        >
                            <div class="space-y-4">
                                <h4 class="max-md:text-h5 font-medium text-accent underline">
                                    {post.data.title}
                                </h4>
                                <p class="text-sm">
                                    {formatDate(post.data.published.toString())}
                                </p>
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </main>
</Layout>
